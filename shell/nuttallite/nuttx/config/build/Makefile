include $(APPDIR)/Make.defs

PROGNAME  = $(CONFIG_FLUXEMU_SHELL_NUTTALLITE_PROGNAME)
PRIORITY  = $(CONFIG_FLUXEMU_SHELL_NUTTALLITE_PRIORITY)
STACKSIZE = $(CONFIG_FLUXEMU_SHELL_NUTTALLITE_STACKSIZE)
MODULE    = $(CONFIG_FLUXEMU_SHELL_NUTTALLITE)

RUSTLIB := $(call RUST_GET_BINDIR,$(CRATE),$(WORKSPACE_DIR))

context:: $(RUSTLIB)

$(RUSTLIB): $(call RUST_CARGO_SRCS,$(CRATE),$(WORKSPACE_DIR))
	$(call RUST_CARGO_BUILD,fluxemu-shell-nuttallite,$(WORKSPACE_DIR))

clean::
	$(call RUST_CARGO_CLEAN,$(WORKSPACE_DIR))

include $(APPDIR)/Application.mk
