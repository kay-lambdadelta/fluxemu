From 91eb4d4a15244fc7aa228936755f0c5e1f2c66b8 Mon Sep 17 00:00:00 2001
From: yushuailong <yyyusl@qq.com>
Date: Thu, 5 Nov 2026 00:44:09 +0800
Subject: [PATCH] fs/fat: Align assignments in truncation paths.

Align adjacent assignments when positioning the EOF cursor and
preserving the directory sector, following the columnar layout
preferred by the NuttX coding style.

Only whitespace changes. Verified an empty whitespace-insensitive
diff, identical non-whitespace text and passing full-file checkpatch.

Assisted-by: Codex:GPT-6
Signed-off-by: yushuailong <yyyusl@qq.com>
---
 fs/fat/fs_fat32.c     | 4 ++--
 fs/fat/fs_fat32util.c | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/fs/fat/fs_fat32.c b/fs/fat/fs_fat32.c
index 78773a11308b1..7badc47e02bb4 100644
--- a/fs/fat/fs_fat32.c
+++ b/fs/fat/fs_fat32.c
@@ -2866,9 +2866,9 @@ static int fat_truncate(FAR struct file *filep, off_t length)
        * cluster of the file.
        */
 
-      savepos = filep->f_pos;
+      savepos      = filep->f_pos;
       filep->f_pos = oldsize;
-      ret = fat_get_sectors(filep, false);
+      ret          = fat_get_sectors(filep, false);
       filep->f_pos = savepos;
       if (ret < 0)
         {
diff --git a/fs/fat/fs_fat32util.c b/fs/fat/fs_fat32util.c
index 09a9737c4646b..4fc6b13cbbc12 100644
--- a/fs/fat/fs_fat32util.c
+++ b/fs/fat/fs_fat32util.c
@@ -1546,7 +1546,7 @@ int fat_dirshrink(struct fat_mountpt_s *fs, FAR uint8_t *direntry,
   /* This sector needs to be written back to disk eventually */
 
   fs->fs_dirty = true;
-  savesector = fs->fs_currentsector;
+  savesector   = fs->fs_currentsector;
 
   /* Now find the cluster change to be removed.  Start with the cluster
    * after the current one (which we know contains data).
